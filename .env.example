# LLM provider for local scripts: anthropic, openai, deepseek, github-copilot, openrouter
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI / compatible endpoint
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o
# OPENAI_MODEL_FALLBACKS=qwen-turbo,qwen-max

# DeepSeek
# DEEPSEEK_API_KEY=sk-xxxxx
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MODEL_FALLBACKS=

# OpenRouter
# OPENROUTER_API_KEY=sk-or-xxxxx
# OPENROUTER_MODEL=anthropic/claude-sonnet-4
# OPENROUTER_MODEL_FALLBACKS=

# GitHub Copilot
# GITHUB_COPILOT_MODEL=gpt-4o
# GITHUB_COPILOT_MODEL_FALLBACKS=

# Optional: raises GitHub API limits for local runs.
# If you have GitHub CLI logged in, the local automation can derive this from `gh auth token`.
# GITHUB_TOKEN=ghp_xxxxx

# Optional: enables Product Hunt report.
# PRODUCTHUNT_TOKEN=xxxxx
